{
  "schema_version": 1,
  "id": "hbr",
  "name": "HBR 研究室",
  "version": "0.12.1",
  "requires": { "host_api": 1 },
  "description": "炽焰天穹的卡面 box 与突破记录、一键导出 box 图，以及排轴与 Boss 资料。",
  "category": "游戏",
  "order": 35,
  "accent": "#c4553f",
  "icon": "public/hbr-icon.png",
  "launch": { "command": ["{pythonw}", "hbr_app.py", "--serve", "--data-dir", "{data_dir}"], "cwd": "." },
  "url": { "runtime": "{data_dir}/runtime.json" },
  "health": { "type": "runtime", "path": "{data_dir}/runtime.json" },
  "open": ["tab", "window"],
  "stop": { "type": "wbkit", "allow_force": false }
}
